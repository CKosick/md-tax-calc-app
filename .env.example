# CarTaxHub Environment Configuration

# Canonical site URL (used for metadata, open graph, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://cartaxhub.com

# Google Analytics 4 (GA4) Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification code (optional)
# Can be specified as GOOGLE_SITE_VERIFICATION or NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Affiliate / Partner Links (PartnerSlot renders nothing until real URLs are configured)
# Real affiliate links can be set here or per slot ID (e.g. NEXT_PUBLIC_PARTNER_<SLOT_ID>_URL) without code changes
NEXT_PUBLIC_PARTNER_INSURANCE_URL=
NEXT_PUBLIC_PARTNER_LOAN_URL=

